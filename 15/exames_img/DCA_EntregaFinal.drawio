        <mxCell id="IwkmOcOenap3dzLKWHqU-41" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;div&gt;F&lt;sup&gt;i&lt;/sup&gt; = função de duração da atividade i&lt;/div&gt;&lt;div&gt;A&lt;sup&gt;e&lt;/sup&gt; = função de chegada da entidade e&lt;/div&gt;&lt;div&gt;n&lt;sup&gt;r &lt;/sup&gt;= número de recursos r disponíveis no sistema&lt;/div&gt;&lt;div&gt;* Informação premissada pelos alunos&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="IwkmOcOenap3dzLKWHqU-1">
