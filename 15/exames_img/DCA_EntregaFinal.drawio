        <mxCell id="N9HjPN9qNd_cLr2G6BPb-41" value="&lt;b&gt;Legenda&lt;/b&gt;&lt;div&gt;F&lt;sup&gt;i&lt;/sup&gt; = função de duração da atividade i&lt;/div&gt;&lt;div&gt;A&lt;sup&gt;e&lt;/sup&gt; = função de chegada da entidade e&lt;/div&gt;&lt;div&gt;n&lt;sup&gt;r &lt;/sup&gt;= número de recursos r disponíveis no sistema&lt;/div&gt;&lt;div&gt;* Informação premissada pelos alunos&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="N9HjPN9qNd_cLr2G6BPb-1">
          <mxGeometry x="510" y="-1420" width="300" height="130" as="geometry" />
        </mxCell>
        <mxCell id="N9HjPN9qNd_cLr2G6BPb-42" value="&lt;b&gt;Desvios&lt;/b&gt;&lt;div&gt;&lt;b&gt;A ou B?&lt;/b&gt;&lt;/div&gt;&lt;div&gt;A = x%&lt;/div&gt;&lt;div&gt;B = (1 - x)%&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;C ou D?&lt;/b&gt;&lt;/div&gt;&lt;div&gt;C = Y%&lt;/div&gt;&lt;div&gt;D = (1 - Y)%&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;E ou F?&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Se U = 1, então E&lt;/div&gt;&lt;div&gt;Se U = 0, então F&amp;nbsp;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="N9HjPN9qNd_cLr2G6BPb-1">
          <mxGeometry x="370" y="-1440" width="150" height="60" as="geometry" />
        </mxCell>
