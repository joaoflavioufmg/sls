        <mxCell id="IwkmOcOenap3dzLKWHqU-42" value="&lt;b&gt;Desvios&lt;/b&gt;&lt;div&gt;&lt;b&gt;A ou B?&lt;/b&gt;&lt;/div&gt;&lt;div&gt;A = x%&lt;/div&gt;&lt;div&gt;B = (1 - x)%&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;C ou D?&lt;/b&gt;&lt;/div&gt;&lt;div&gt;C = Y%&lt;/div&gt;&lt;div&gt;D = (1 - Y)%&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;E ou F?&lt;/b&gt;&lt;/div&gt;&lt;div&gt;E = Z%&lt;/div&gt;&lt;div&gt;F = (1 - Z)%&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;G ou H?&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Se U = 1, então E&lt;/div&gt;&lt;div&gt;Se U = 0, então F&amp;nbsp;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="IwkmOcOenap3dzLKWHqU-1">
