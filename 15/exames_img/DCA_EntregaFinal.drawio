        <mxCell id="y2BVPRy9H16QLSCz-Vmu-42" value="&lt;b&gt;Desvios&lt;/b&gt;&lt;div&gt;&lt;b&gt;A ou B?&lt;/b&gt;&lt;/div&gt;&lt;div&gt;A = x%&lt;/div&gt;&lt;div&gt;B = (1 - x)%&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;C ou D?&lt;/b&gt;&lt;/div&gt;&lt;div&gt;C = Y%&lt;/div&gt;&lt;div&gt;D = (1 - Y)%&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;b&gt;E ou F?&lt;/b&gt;&lt;/div&gt;&lt;div&gt;Se U = 1, então E&lt;/div&gt;&lt;div&gt;Se U = 0, então F&amp;nbsp;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="y2BVPRy9H16QLSCz-Vmu-1" vertex="1">
